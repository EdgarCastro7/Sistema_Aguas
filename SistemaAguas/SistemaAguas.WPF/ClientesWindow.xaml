<Window x:Class="SistemaAguas.WPF.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaAguas.WPF"
        mc:Ignorable="d"
        Title="Gestão de Clientes" Height="450" Width="850">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestão de Clientes"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="77.722"/>
                <ColumnDefinition Width="172.278"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nome:" Grid.Row="0" Margin="0,0,0,28" Grid.RowSpan="2"/>
            <TextBox x:Name="txtNome"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="5,5,5,5"/>

            <TextBlock Text="NIF:"
                   Grid.Row="0"
                   Grid.Column="2" Margin="0,0,0,28" Grid.RowSpan="2"/>
            <TextBox x:Name="txtNif"
                 Grid.Row="0"
                 Grid.Column="3"
                 Margin="5,5,5,5" Grid.ColumnSpan="2"/>

            <TextBlock Text="Morada:"
                   Grid.Row="1" Margin="0,0,0,28" Grid.RowSpan="2"/>
            <TextBox x:Name="txtMorada"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="5,5,5,5"/>

            <TextBlock Text="Código Postal:"
                   Grid.Row="1"
                   Grid.Column="2" Margin="0,0,0,28" Grid.RowSpan="2"/>
            <TextBox x:Name="txtCodigoPostal"
                 Grid.Row="1"
                 Grid.Column="3"
                 Margin="5,5,5,5" Grid.ColumnSpan="2"/>

            <TextBlock Text="Contacto:"
                   Grid.Row="2" Margin="0,0,0,30" Grid.RowSpan="2"/>
            <TextBox x:Name="txtContacto"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="5,5,5,5"/>

            <TextBlock Text="Email:"
                   Grid.Row="2"
                   Grid.Column="2" Margin="0,0,0,30" Grid.RowSpan="2"/>
            <TextBox x:Name="txtEmail"
                 Grid.Row="2"
                 Grid.Column="3"
                 Margin="5,5,5,5" Grid.ColumnSpan="2"/>

            <CheckBox x:Name="chkAtivo"
                  Content="Cliente Ativo"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="5,5,5,5"/>

            <StackPanel Orientation="Horizontal"
                    Grid.Row="3"
                    Grid.Column="2"
                    HorizontalAlignment="Left" Grid.ColumnSpan="3">

                <Button x:Name="btnAdicionar"
                    Content="Adicionar"
                    Width="90"
                    Margin="5" Click="btnAdicionar_Click"/>

                <Button x:Name="btnEditar"
                    Content="Editar"
                    Width="90"
                    Margin="5" Click="btnEditar_Click"/>

                <Button x:Name="btnEliminar"
                    Content="Eliminar"
                    Width="90"
                    Margin="5" Click="btnEliminar_Click"/>

                <Button x:Name="btnLimpar"
                    Content="Limpar"
                    Width="90"
                    Margin="5" Click="btnLimpar_Click"/>

            </StackPanel>

        </Grid>

        <DataGrid x:Name="dgClientes"
              Grid.Row="2"
              Margin="0,20,0,0"
              AutoGenerateColumns="True"
              IsReadOnly="True"
              SelectionChanged="dgClientes_SelectionChanged"/>
    </Grid>
</Window>
